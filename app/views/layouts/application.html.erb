<!DOCTYPE html>
<html>
  <head>
    <title>RoadChecker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header>
      <nav class='navbar navbar-expand navbar-dark bg-dark'>
        <div class='container'>
          <a class="navbar-brand" href="/"><span>Road Checker</span></a>
          <div>
            <ul class="navbar-nav ml-auto">
              <li>
                <!--後で管理者権限内へ-->
                <%= link_to '国道登録', new_admin_road_path,class: 'nav-link text-light'  %>
                <!--ここまで-->
              </li>
              <li><%= link_to '国道一覧', admin_roads_path,class: 'nav-link text-light'  %></li>
              <% if customer_signed_in? %>
                <li><%= link_to '日記投稿', new_drive_diary_path,class: 'nav-link text-light'  %></li>
                <li><%= link_to 'マイ日記', customer_path(current_customer.id),class: 'nav-link text-light'  %></li>
                <li><%= link_to 'ログアウト', destroy_customer_session_path, method: :delete,class: 'nav-link text-light'  %></li>
              <% else %>
                <li><%= link_to '会員登録', new_customer_registration_path,class: 'nav-link text-light'  %></li>
                <li><%= link_to 'ログイン', new_customer_session_path,class: 'nav-link text-light'  %></li>
              <% end %>
            </ul>
          </div>
        </div>
        
      </nav>
    </header>
    <%= yield %>
  </body>
</html>
